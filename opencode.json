{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/instructions/*.md"],
  "formatter": {
    "rustfmt": {
      "command": [
        "wsl",
        "-d",
        "Ubuntu-Dev",
        "--exec",
        "/home/brian/.opencode/bin/rustfmt-wsl",
        "$FILE"
      ],
      "extensions": [".rs"]
    }
  },
  "watcher": {
    "ignore": ["target/**", "mutants.out/**"]
  },
  "permissions": [
    { "action": "shell", "resource": "*git push*", "effect": "ask" },
    { "action": "shell", "resource": "*gh pr create*", "effect": "ask" },
    { "action": "edit", "resource": "CHANGELOG.md", "effect": "ask" }
  ]
}
